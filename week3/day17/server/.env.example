# ---- Server ----
PORT=3000
NODE_ENV=development
# Must match the Vite dev URL so Express CORS + Socket.IO accept the frontend
FRONTEND_URL=http://localhost:5173

# ---- Auth (used by middleware/auth.js AuthService + User.generateAuthToken) ----
JWT_SECRET=myNameIsOmair
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ---- MongoDB (users, auth, notifications) ----
MONGODB_URI=mongodb://localhost:27017/sda-training

# ---- PostgreSQL (products, orders, order_items, reviews) ----
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=sda_training
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
# Alternative single-URL form (libpq style); individual fields above take precedence in code
# POSTGRES_URL=postgresql://postgres:password@localhost:5432/sda_training

# ---- Redis (cache middleware + notification unread counts) ----
REDIS_URL=redis://localhost:6379

# ---- OAuth (optional; leave blank to disable social login) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
