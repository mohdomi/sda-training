# Copy to .env and fill in
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_FALLBACK_MODEL=cohere/north-mini-code:free
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=SDA Capstone MVP

# Phase 2: Postgres-only + Redis (Docker). Set DB_ADAPTER=postgres to use PG.
POSTGRES_URL=postgresql://postgres:password@localhost:5432/sda_capstone
REDIS_URL=redis://localhost:6379
# DB_ADAPTER=file
DB_ADAPTER=postgres

# OAuth (Google): fill in from Google Cloud Console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_CALLBACK_BASE=http://localhost:5000
# NOTE: docker compose overrides hostnames (postgres/redis service names)
# and FRONTEND_URL=http://localhost — see devops/docker-compose.yml
